{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dayline Feedback Canvas v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "blocos",
    "conexoes"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "blocos": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tipo",
              "x",
              "y",
              "largura",
              "altura",
              "conteudo"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "tipo": {
                "const": "nota"
              },
              "x": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "largura": {
                "type": "number",
                "minimum": 160,
                "maximum": 10000
              },
              "altura": {
                "type": "number",
                "minimum": 120,
                "maximum": 10000
              },
              "conteudo": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "texto"
                ],
                "properties": {
                  "texto": {
                    "type": "string",
                    "maxLength": 20000
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tipo",
              "x",
              "y",
              "largura",
              "altura",
              "conteudo"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "tipo": {
                "const": "imagem"
              },
              "x": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "largura": {
                "type": "number",
                "minimum": 160,
                "maximum": 10000
              },
              "altura": {
                "type": "number",
                "minimum": 120,
                "maximum": 10000
              },
              "conteudo": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$",
                    "maxLength": 4000
                  },
                  "descricao": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tipo",
              "x",
              "y",
              "largura",
              "altura",
              "conteudo"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "tipo": {
                "const": "link"
              },
              "x": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "largura": {
                "type": "number",
                "minimum": 160,
                "maximum": 10000
              },
              "altura": {
                "type": "number",
                "minimum": 120,
                "maximum": 10000
              },
              "conteudo": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$",
                    "maxLength": 4000
                  },
                  "titulo": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "tipo",
              "x",
              "y",
              "largura",
              "altura",
              "conteudo"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "tipo": {
                "const": "print"
              },
              "x": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "largura": {
                "type": "number",
                "minimum": 160,
                "maximum": 10000
              },
              "altura": {
                "type": "number",
                "minimum": 120,
                "maximum": 10000
              },
              "conteudo": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "tempo_video_segundos"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$",
                    "maxLength": 4000
                  },
                  "tempo_video_segundos": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 604800
                  },
                  "descricao": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        ]
      }
    },
    "conexoes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "origem",
          "destino"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "origem": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "destino": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          }
        }
      }
    }
  }
}
